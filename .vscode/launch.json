{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",

  "configurations": [{
    "name": "Transform",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/transform",
      "runtimeExecutable": "tsx",
      "env": {
        "NODE_ENV": "test"
      },
      "runtimeArgs": [
        "src/transform-data-single-file.ts"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {"name": "Acquire My Space Memberships",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/acquire",
      "runtimeExecutable": "tsx",
      "env": {
        "NODE_ENV": "test"
      },
      "runtimeArgs": [
        "src/acquire-my-space-memberships.ts"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "AcquireSpaces",
      "request": "launch",
      "runtimeArgs": [
        "run",
        "acquire-spaces"
      ],
      "runtimeExecutable": "npm",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node",
      "cwd": "${workspaceFolder}//acquire"
    },
    {
      "name": "GenerateVisualisation",
      "request": "launch",
      "runtimeArgs": [
        "run",
        "generate-visualisation"
      ],
      "runtimeExecutable": "npm",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
  ]
}